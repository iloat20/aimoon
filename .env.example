# DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# LongCat AI (OpenAI 兼容 API, https://api.longcat.chat)
# 由 AI_PROVIDER 切换默认后端: deepseek(默认) / longcat
AI_PROVIDER=deepseek
LONGCAT_API_KEY=your-longcat-api-key-here
LONGCAT_BASE_URL=https://api.longcat.chat
LONGCAT_MODEL=LongCat-2.0
LONGCAT_MAX_TOKENS=24576
LONGCAT_ANALYSIS_MAX_TOKENS=4096
LONGCAT_TEMPERATURE=0.3
# LONGCAT_THINKING_ENABLED=true  # 留空=模型默认(开启);false=关闭思考

# 雪球 Cookie (从浏览器开发者工具获取)
XUEQIU_COOKIE=xq_a_token=xxx; u=xxx;

# 雪球 Token (pysnowball 需要)
XUEQIU_TOKEN=your-xueqiu-token

# Mock 模式: 设置为 true 时使用模拟数据，无需真实 API
MOCK_MODE=false

# 数据缓存
CACHE_DIR=./cache
